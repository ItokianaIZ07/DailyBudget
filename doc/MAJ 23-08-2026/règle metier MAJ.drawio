  <diagram id="spendwise-business-rules" name="Règles Métier & Architecture Logique SpendWise">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- NIVEAU 1 : SALAIRE MENSUEL -->
        <mxCell id="salary_node" value="SALAIRE MENSUEL&#10;(Unique par mois : Année + Mois)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="434" y="40" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- SEPARATION DES FLUX -->
        <!-- BRANCHE GAUCHE : PREVISIONNEL (BUDGETS) -->
        <mxCell id="group_plan" value="FLUX PRÉVISIONNEL (Allocations)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=30;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="150" width="410" height="260" as="geometry" />
        </mxCell>

        <mxCell id="daily_budget" value="BUDGET QUOTIDIEN&#10;(Unique par jour : Date → Budget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="group_plan">
          <mxGeometry x="105" y="50" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sum_budget" value="BUDGET PLANIFIÉ&#10;Σ Budgets Quotidiens du mois" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="group_plan">
          <mxGeometry x="105" y="160" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="edge_b1" edge="1" parent="group_plan" source="daily_budget" target="sum_budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BRANCHE DROITE : REEL (DEPENSES) -->
        <mxCell id="group_real" value="FLUX RÉEL (Consommation)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;startSize=30;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="639" y="150" width="410" height="260" as="geometry" />
        </mxCell>

        <mxCell id="daily_expense" value="DÉPENSES RÉELLES&#10;(1..N par jour : Date → Dépenses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="group_real">
          <mxGeometry x="105" y="50" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sum_expense" value="TOTAL DÉPENSÉ&#10;Σ Dépenses Réelles du mois" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="group_real">
          <mxGeometry x="105" y="160" width="200" height="50" as="geometry" />
